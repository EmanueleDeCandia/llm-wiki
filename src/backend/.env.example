# LLM Wiki — configurazione sidecar
# COPIA IN .env E COMPLETA SOLO SE SI ABILITA UN PROVIDER LLM.
# In assenza di questo file (o con LLM_PROVIDER=none) l'applicazione opera
# in modalità offline deterministica: NESSUN modello AI è invocato.

# --- Engine (modulo opzionale) ---------------------------------------------
# none      => motore deterministico (default, nessun AI)
# openai    => richiede OPENAI_API_KEY
# anthropic => richiede ANTHROPIC_API_KEY
# ollama    => richiede un server Ollama raggiungibile (modello locale)
LLM_PROVIDER=none

# --- OpenAI (o endpoint compatibile, es. vLLM) ------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# --- Anthropic Claude --------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Ollama / vLLM locali -----------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# --- Server ------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8100

# --- Sandbox -----------------------------------------------------------------
SANDBOX_TIMEOUT_SECONDS=30

# --- Parser PDF -----------------------------------------------------------------
# auto        => docling (se installato) → llamaparse (se c'è la chiave qui sotto)
#               → built-in pypdf+pymupdf+tables (sempre disponibile, zero AI)
# pypdf       => motore built-in: testo + tabelle (PDF con linee via PyMuPDF,
#                tabelle allineate senza linee via euristica su coordinate)
# docling     => vincolato a docling (richiede il package: pip install docling)
# marker      => vincolato a marker-pdf (richiede il package)
# llamaparse  => API cloud LlamaIndex: Markdown con tabelle e formule LaTeX
LLW_PDF_ENGINE=auto

# Abilita l'enrichment formule in LaTeX vero con docling (modelli aggiuntivi).
# 1 = attivo, vuoto/assente = disattivo
LLW_PDF_FORMULAS=0

# --- LlamaParse (cloud, solo se LLW_PDF_ENGINE=llamaparse oppure =auto) ---------
# ATENZIONE: con questo engine il PDF viene inviato al provider LlamaIndex:
# usarlo solo con documenti non sensibili.
LLAMAPARSE_API_KEY=
# LLW_LLAMAPARSE_URL=https://cloud.llamaindex.ai/api/parsing
